pkgname=dzglauncher
pkgver=1.3.0
pkgrel=1
pkgdesc="Browse DayZ servers, favorites, Workshop mods, and launch via Steam"
arch=('x86_64')
url="https://github.com/herberthudson/dzglauncher"
license=('Apache')
depends=('gtk3' 'webkit2gtk-4.1' 'librsvg' 'hicolor-icon-theme' 'desktop-file-utils')
optdepends=('steam: launch DayZ via Steam')
install=dzglauncher.install
options=('!strip')
source=("https://github.com/herberthudson/dzglauncher/releases/download/v${pkgver}/dzglauncher-${pkgver}-linux-amd64.tar.gz")
sha256sums=('94bafb35d2a0e2e3f22e684ebda1bce1845c6937efde1422cb32db4aa6854847')

package() {
  cd "${srcdir}"
  install -Dm755 dzglauncher "${pkgdir}/usr/bin/dzglauncher"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 share/applications/dzglauncher.desktop "${pkgdir}/usr/share/applications/dzglauncher.desktop"
  install -Dm644 share/icons/hicolor/256x256/apps/dzglauncher.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/dzglauncher.png"
}
