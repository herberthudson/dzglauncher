#!/bin/bash
if [ -z "${APPDIR:-}" ]; then
  HERE=$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")
  export APPDIR="$HERE"
fi
export PATH="$APPDIR/usr/bin:${PATH:-}"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
shopt -s nullglob
if [ -d "$APPDIR/apprun-hooks" ]; then
  for h in "$APPDIR/apprun-hooks/"*; do
    if [ -f "$h" ]; then
      . "$h"
    fi
  done
fi
shopt -u nullglob
WK="$APPDIR/usr/lib/x86_64-linux-gnu/webkit2gtk-4.1"
if [ -d "$WK" ]; then
  export WEBKIT_EXEC_DIR="$WK"
fi
exec "$APPDIR/usr/bin/dzglauncher" "$@"
